# LLM provider: mock | groq | xai | ollama | openai | anthropic
LLM_PROVIDER=
LLM_MODEL=

# Groq (initial hosted provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional alternatives
XAI_API_KEY=
XAI_MODEL=grok-3

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# PostgreSQL deployment. Leave DATABASE_URL empty to use the local SQLite paths below.
DATABASE_URL=
CHECKPOINT_BACKEND=auto
# Required when CHECKPOINT_BACKEND resolves to postgres. Generate 32 random bytes.
LANGGRAPH_AES_KEY=
OWNER_ID=local
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=25

# Local SQLite data
INVENTORY_DB=db/inventory.db
CHECKPOINT_DB=db/checkpoints.db
OUTPUT_DIR=outputs
HIGH_VALUE_USD=10000
FX_EUR_USD=1.08

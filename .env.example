# LLM provider: mock | xai | ollama | openai | anthropic
LLM_PROVIDER=
LLM_MODEL=

# xAI (preferred for the agentic demo)
XAI_API_KEY=
XAI_MODEL=grok-3

# Optional alternatives
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Local data
INVENTORY_DB=db/inventory.db
CHECKPOINT_DB=db/checkpoints.db
OUTPUT_DIR=outputs
HIGH_VALUE_USD=10000
FX_EUR_USD=1.08
